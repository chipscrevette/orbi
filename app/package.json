{
  "name": "orbi-app",
  "productName": "Orbi",
  "version": "0.1.0",
  "private": true,
  "description": "Orbi : l'application de bureau de l'assistant d'urbanisme 100 % local.",
  "author": "Orbi",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preparer": "node scripts/preparer.mjs",
    "dev": "npm run preparer && electron-vite dev",
    "dev:web": "npm run preparer && vite --config vite.web.config.mts",
    "test": "vitest run",
    "test:suivi": "vitest",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "npm run preparer && npm run typecheck && electron-vite build",
    "build:web": "npm run preparer && vite build --config vite.web.config.mts",
    "apercu": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis --config electron-builder.yml",
    "serveur-factice": "node scripts/serveur-factice.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "~28.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.50.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
